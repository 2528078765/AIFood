# ==========================================
#  食光助手 · 环境变量配置
#  复制为 .env 并填入真实值
# ==========================================

# --- AI 服务 ---
DEEPSEEK_API_KEY="sk-xxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DASHSCOPE_API_KEY="sk-xxx"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
TAVILY_API_KEY="tvly-xxx"

# --- 数据库 (SQLite, 无需额外配置) ---
DATABASE_URL="sqlite+aiosqlite:///./aifood.db"

# --- 微信小程序 ---
WECHAT_APPID="wxdc32a7e5cbea387e"
WECHAT_SECRET="你的微信小程序AppSecret"

# --- 安全密钥 ---
# ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_hex(32))" 生成
ENCRYPTION_KEY="xxx"
# JWT_SECRET: 任意复杂随机字符串
JWT_SECRET="xxx"

# --- 应用配置 ---
DEBUG=false
API_PREFIX="/api"
