/* Warning */
.warning-card {
  background: #FFF3CD; border-radius: 12rpx;
  padding: 20rpx 28rpx; margin-bottom: 18rpx;
  font-size: 24rpx; color: #856404;
}

.meal-tabs {
  display: flex; flex-direction: row;
  background: var(--bg-white); border-radius: 100rpx;
  padding: 6rpx; margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.meal-tab {
  flex: 1; text-align: center; padding: 18rpx 0;
  font-size: 26rpx; color: var(--text-secondary);
  border-radius: 100rpx; transition: all 0.3s;
}
.meal-tab.active {
  background: linear-gradient(135deg, #07C160, #05A94F);
  color: #fff; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.25);
}

.meal-section { margin-bottom: 28rpx; }
.meal-section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8rpx 14rpx;
}
.meal-label { font-size: 30rpx; font-weight: 700; color: var(--text); }

.recipe-mini-card {
  display: flex; flex-direction: row; align-items: center;
  padding: 18rpx; background: var(--bg-white);
  border-radius: var(--radius-lg); margin-bottom: 14rpx;
  box-shadow: var(--shadow-xs);
  transition: all 0.2s;
}
.recipe-mini-card:active { transform: scale(0.98); }

.recipe-thumb {
  width: 130rpx; height: 130rpx; border-radius: var(--radius-md);
  background: var(--bg); flex-shrink: 0;
}
