/* ── Token Banner ── */
.token-banner {
  display: flex; flex-direction: column;
  padding: 24rpx 28rpx; border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
}
.token-active {
  background: linear-gradient(135deg, #E8F8EF, #D0F0DC);
  border: 1rpx solid #B8E6CC;
}
.token-empty {
  background: linear-gradient(135deg, #FFF5F5, #FDEAEA);
  border: 1rpx solid #F5C6C6;
}
.token-personal {
  background: linear-gradient(135deg, #E8F4FD, #D0E8FA);
  border: 1rpx solid #B8D8F0;
}
.token-banner-icon { font-size: 44rpx; }
.token-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.token-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

.token-progress-wrap { width: 100%; margin-top: 16rpx; }
.token-progress-bar {
  height: 16rpx; border-radius: 8rpx; background: #E8E8E8;
  overflow: hidden;
}
.token-progress-fill {
  height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, #07C160, #05D06D);
  transition: width 0.5s ease;
}
.token-progress-text {
  display: flex; justify-content: space-between;
  margin-top: 8rpx;
}
.token-progress-left { font-size: 28rpx; font-weight: 800; color: var(--primary); }
.token-progress-right { font-size: 22rpx; color: var(--text-muted); }

/* ── Tutorial ── */
.tutorial-card { padding: 24rpx; }
.tutorial-step {
  display: flex; align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.tutorial-step:last-child { border-bottom: none; padding-bottom: 0; }
.tutorial-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #05A94F);
  color: #fff; font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 16rpx;
}
.tutorial-body { flex: 1; }
.tutorial-step-title { font-size: 26rpx; font-weight: 600; color: var(--text); }
.tutorial-step-desc { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; line-height: 1.5; }

/* ── Provider Cards ── */
.provider-header { margin-bottom: 8rpx; }
.provider-name { font-size: 30rpx; font-weight: 700; }
.provider-desc { font-size: 24rpx; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8rpx; }
.provider-meta { font-size: 22rpx; color: var(--text-muted); margin-bottom: 20rpx; }
.provider-price { display: inline; padding: 4rpx 12rpx; background: var(--bg); border-radius: 100rpx; }

.provider-input-area { }

.input-row { display: flex; align-items: center; position: relative; }
.key-input { flex: 1; padding-right: 80rpx !important; }
.input-suffix {
  position: absolute; right: 0; top: 0; bottom: 0;
  width: 72rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}

.provider-actions {
  display: flex; gap: 12rpx; margin-top: 12rpx;
}

.test-result {
  margin-top: 12rpx; padding: 14rpx 18rpx;
  border-radius: var(--radius-sm); font-size: 22rpx;
}
.test-result.success { background: var(--primary-soft); color: var(--primary); }
.test-result.error { background: var(--danger-light); color: var(--danger); }
