/* ── Greeting Card ── */
.greeting-card {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
}
.greeting-card-bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 40%, #059A4D 100%);
}
.greeting-card-content {
  position: relative; z-index: 1;
  padding: 32rpx 28rpx 24rpx;
}
.greeting-title {
  font-size: 40rpx; font-weight: 800; color: #FFFFFF;
  letter-spacing: 1rpx;
}
.greeting-sub {
  font-size: 26rpx; color: rgba(255,255,255,0.82); margin-top: 8rpx;
}
.greeting-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5); flex-shrink: 0;
}

.greeting-stats {
  position: relative; z-index: 1;
  display: flex; justify-content: space-around;
  padding: 0 28rpx 28rpx;
}
.greeting-stat { text-align: center; }
.greeting-stat-val { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.greeting-stat-lbl { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 4rpx; }

.bf-info-icon {
  font-size: 20rpx; color: rgba(255,255,255,0.6);
  margin-left: 4rpx; font-weight: 400;
}

.greeting-fitness {
  position: relative; z-index: 1;
  display: flex; justify-content: space-around; align-items: center;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
  margin: 0 28rpx;
}
.gf-item { text-align: center; }
.gf-val { font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,0.9); }
.gf-lbl { font-size: 18rpx; color: rgba(255,255,255,0.6); margin-top: 2rpx; }

/* ── Calorie Card ── */
.calorie-card { padding: 24rpx; }
.calorie-main {
  display: flex; align-items: center; gap: 32rpx;
  margin-top: 12rpx;
}

.calorie-ring-wrap { flex-shrink: 0; }
.calorie-ring {
  position: relative; width: 170rpx; height: 170rpx;
}
.ring-bg {
  position: absolute; inset: 0;
  border-radius: 50%;
  background: #EDEDED;
}
.ring-fill {
  position: absolute; inset: 0;
  border-radius: 50%;
  -webkit-mask: radial-gradient(transparent 58%, black 62%);
  mask: radial-gradient(transparent 58%, black 62%);
}
.ring-center {
  position: absolute; inset: 16rpx;
  border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-value { font-size: 40rpx; font-weight: 800; color: var(--primary); line-height: 1; }
.ring-label { font-size: 20rpx; color: var(--text-muted); margin-top: 4rpx; }

.macro-bars { flex: 1; min-width: 0; }
.macro-row {
  display: flex; align-items: center; margin-bottom: 16rpx;
}
.macro-row:last-child { margin-bottom: 0; }
.macro-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; margin-right: 12rpx;
}
.macro-protein { background: #FF6B6B; }
.macro-fat { background: #FFB347; }
.macro-carbs { background: #4ECDC4; }
.macro-info { flex: 1; min-width: 0; margin-right: 10rpx; }
.macro-name { font-size: 22rpx; color: var(--text-secondary); margin-bottom: 6rpx; }
.macro-track {
  height: 8rpx; border-radius: 4rpx; background: #EDEDED; overflow: hidden;
}
.macro-fill { height: 100%; border-radius: 4rpx; transition: width 0.5s ease; }
.macro-fill.protein { background: #FF6B6B; }
.macro-fill.fat { background: #FFB347; }
.macro-fill.carbs { background: #4ECDC4; }
.macro-val { font-size: 22rpx; font-weight: 600; color: var(--text-secondary); width: 50rpx; text-align: right; flex-shrink: 0; }

/* ── Quick Actions ── */
.quick-actions {
  display: flex; justify-content: space-between;
  margin-bottom: 24rpx; gap: 14rpx;
}
.qa-item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; padding: 24rpx 8rpx;
  background: #fff; border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  transition: all 0.2s;
}
.qa-item:active { transform: scale(0.96); }
.qa-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; margin-bottom: 10rpx;
}
.qa-icon-chat { background: #E8F8EF; }
.qa-icon-camera { background: #FFF3E0; }
.qa-icon-recipe { background: #E8F4FD; }
.qa-icon-fitness { background: #FDEAEA; }
.qa-label { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; }

/* ── Streak Banner ── */
.streak-banner {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FFF8E1, #FFF3CD);
  border-radius: var(--radius-lg);
  padding: 24rpx; margin-bottom: 24rpx;
}
.streak-icon { font-size: 44rpx; }
.streak-title { font-size: 28rpx; font-weight: 600; color: #333; }
.streak-num { color: #FF8C00; font-size: 36rpx; font-weight: 800; }
.streak-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.streak-arrow { font-size: 40rpx; color: #ccc; font-weight: 300; }

/* ── Food Items ── */
.food-item {
  display: flex; align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.food-item:last-child { border-bottom: none; }
.food-thumb {
  width: 100rpx; height: 100rpx; border-radius: var(--radius-md);
  flex-shrink: 0; background: var(--bg);
}
.food-thumb-placeholder {
  width: 100rpx; height: 100rpx; border-radius: var(--radius-md);
  background: var(--bg); display: flex; align-items: center;
  justify-content: center; font-size: 40rpx; flex-shrink: 0;
}
