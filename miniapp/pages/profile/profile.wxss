/* ── Profile Hero ── */
.profile-hero {
  position: relative; border-radius: var(--radius-xl);
  overflow: hidden; margin-bottom: 24rpx;
}
.profile-hero-bg {
  position: absolute; inset: 0;
  background: linear-gradient(150deg, #07C160 0%, #06AD56 35%, #048B43 100%);
}
.profile-hero-content {
  position: relative; z-index: 1;
  display: flex; align-items: center;
  padding: 36rpx 28rpx 24rpx;
}
.profile-name {
  font-size: 42rpx; font-weight: 700; color: #fff;
}
.profile-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.45);
  flex-shrink: 0;
}

.edit-avatar-btn {
  display: flex; align-items: center; gap: 36rpx;
  padding: 0; margin: 0;
  background: none; border: none;
  text-align: left;
}
.edit-avatar-btn::after { border: none; }

.edit-avatar-img {
  width: 80rpx; height: 80rpx; border-radius: 50%;
}

.edit-avatar-text {
  font-size: 26rpx; color: var(--primary);
}
.profile-goal {
  font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 6rpx;
}

.profile-hero-stats {
  position: relative; z-index: 1;
  display: flex; justify-content: space-around;
  padding: 0 28rpx 32rpx;
}
.phs-item { text-align: center; }
.phs-val {
  font-size: 32rpx; font-weight: 800; color: #fff;
}
.phs-val-accent { color: #FFE082; }
.phs-lbl { font-size: 20rpx; color: rgba(255,255,255,0.65); margin-top: 4rpx; }

.phs-info-icon {
  font-size: 20rpx; color: rgba(255,255,255,0.5);
  margin-left: 4rpx; font-weight: 400;
}

/* ── Info Rows ── */
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border);
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 26rpx; color: var(--text-secondary); }
.info-value { font-size: 26rpx; color: var(--text); font-weight: 500; }

/* ── Form Textarea ── */
.form-textarea {
  width: 100%; min-height: 140rpx;
  font-size: 26rpx; color: var(--text);
  background: var(--bg); border-radius: 12rpx;
  padding: 16rpx 20rpx; box-sizing: border-box;
  line-height: 1.6;
}

/* ── Tag Group ── */
.tag-group { display: flex; flex-wrap: wrap; gap: 14rpx; }
.profile-tag {
  display: inline-block; padding: 12rpx 26rpx;
  font-size: 24rpx; border-radius: 100rpx;
  border: 2rpx solid var(--border); color: var(--text-secondary);
  background: var(--bg-white); transition: all 0.2s;
}
.profile-tag.tag-active {
  color: var(--primary); border-color: var(--primary);
  background: var(--primary-soft);
}
